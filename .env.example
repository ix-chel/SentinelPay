APP_NAME=SentinelPay
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─────────────────────────────────────────────────────────────────────────────
# Database — Supabase PostgreSQL (Local Native)
# ─────────────────────────────────────────────────────────────────────────────
# For Supabase, provide your project connection details.
# Direct connection (port 5432) or Transaction pooler (port 6543).
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=require

# ─────────────────────────────────────────────────────────────────────────────
# Local Storage, Session & Queue (Native Local Dev)
# ─────────────────────────────────────────────────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Queue defaults to synchronous processing for local native dev (no RabbitMQ required)
QUEUE_CONNECTION=sync

# Cache defaults to file store for local native dev (no Redis required)
CACHE_STORE=file

# SentinelPay HMAC Secret (for payload signing)
HMAC_SECRET=your-super-secret-hmac-key-change-in-production

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@sentinelpay.io"
MAIL_FROM_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────────────────────
# Deferred Infrastructure (Phase 4 / Phase 5)
# Redis and RabbitMQ are NOT required for Phase 0 local development.
# These configurations are preserved for future multi-node deployment.
# ─────────────────────────────────────────────────────────────────────────────
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379
# REDIS_DB=0
#
# RABBITMQ_HOST=127.0.0.1
# RABBITMQ_PORT=5672
# RABBITMQ_USER=sentinelpay
# RABBITMQ_PASSWORD=secret
# RABBITMQ_VHOST=sentinelpay
